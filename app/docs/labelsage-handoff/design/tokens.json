{
  "name": "LabelSage MVP",
  "version": 1,
  "updated": "2026-10-23",
  "source": "The onboarding style on the design canvas (OnboardSimple, Chat, Main, Compare, Pick, Profile). Values are the ones the prototype uses; names are what the app should call them.",
  "font": {
    "family": "Outfit",
    "file": "assets/Fonts/Outfit-VariableFont_wght.ttf",
    "license": "SIL OFL 1.1 (assets/LICENSES/Outfit-OFL.txt)",
    "fallback": "SF Pro Rounded",
    "note": "Register the variable font and use Font.custom(\"Outfit\", size:, relativeTo:) so every style scales with Dynamic Type."
  },
  "type": {
    "mascotTitle":   { "size": 30, "weight": 800, "tracking": -0.02, "lineHeight": 1.16, "relativeTo": "largeTitle", "note": "LabelSage's line as the onboarding title. 27 when the line is over 34 characters, 24 when over 58." },
    "screenTitle":   { "size": 34, "weight": 700, "relativeTo": "largeTitle" },
    "sectionTitle":  { "size": 22, "weight": 700, "relativeTo": "title2", "note": "For you, Other options for you, Key ingredients, Settings" },
    "productName":   { "size": 26, "weight": 700, "relativeTo": "title" },
    "cardTitle":     { "size": 17, "weight": 600, "relativeTo": "headline" },
    "body":          { "size": 17, "weight": 400, "relativeTo": "body" },
    "bodyStrong":    { "size": 17, "weight": 600, "relativeTo": "body" },
    "callout":       { "size": 15, "weight": 400, "relativeTo": "callout" },
    "caption":       { "size": 14, "weight": 400, "relativeTo": "subheadline" },
    "footnote":      { "size": 13, "weight": 400, "relativeTo": "footnote" },
    "chip":          { "size": 15, "weight": 600, "relativeTo": "subheadline" },
    "primaryButton": { "size": 20, "weight": 600, "relativeTo": "title3" },
    "number":        { "size": 17, "weight": 400, "features": ["tnum"], "note": "tabular figures for prices, grams, mg" }
  },
  "color": {
    "ink":           { "value": "#1d2b22", "usage": "All text and icons on light grounds; selected outlines; checked boxes" },
    "inkSecondary":  { "value": "#3d4a42", "usage": "Secondary text" },
    "muted":         { "value": "#6b6656", "usage": "Captions, meta, placeholders (5.5:1 on white)" },
    "mutedGreen":    { "value": "#6f7a73", "usage": "Captions on green and white cards" },
    "hairline":      { "value": "#e5e5ea", "usage": "Separators inside cards" },
    "controlBorder": { "value": "#e3e1df", "usage": "Unchecked checkbox and radio" },
    "surface":       { "value": "#ffffff", "usage": "Cards, tiles, fields" },
    "amber":         { "value": "#eb9d15", "usage": "The one primary button per screen. Text on it is ink (7:1). Never white text on amber, never on a verdict." },
    "amberDisabled": { "value": "#efe6d3", "usage": "Primary button while the step has no answer; text #a89f8a" },
    "brandGreen":    { "value": "#26834e", "usage": "Switch on, links, brand moments" },
    "brandGreenDeep":{ "value": "#1b6b3e", "usage": "Small green text and links" },
    "cream":         { "value": "#fefbdc", "usage": "Brand cream (splash wordmark, app icon)" },
    "letterTile":    { "value": "#f3ead8", "usage": "Icon fallback tile; letter #8a6a3a" },
    "letterTileInk": { "value": "#8a6a3a" }
  },
  "verdict": {
    "ok":          { "color": "#1dbf73", "wash": "#e4f7ee", "symbol": "checkmark.circle", "word": "OK for {names}" },
    "checkFirst":  { "color": "#ffd449", "wash": "#fff5cc", "symbol": "exclamationmark.triangle", "word": "Check first" },
    "notFor":      { "color": "#ef4b3f", "wash": "#ffe9e6", "symbol": "nosign", "word": "Not for {names}" },
    "cantConfirm": { "color": "#6b6656", "wash": "#f4f0d8", "symbol": "questionmark.circle.fill", "word": "Can’t confirm", "note": "Stone wash, muted ink symbol. Never styled like OK." },
    "rule": "Color and symbol always travel together; the word appears wherever there is room. These colors are for verdicts only, never decoration."
  },
  "chips": {
    "avoid":    { "background": "#fbe9e5", "badge": "#fbe1dc", "usage": "Avoid (hides it)" },
    "preferNot":{ "background": "#fdf3da", "badge": "#fdf0cf", "usage": "Prefer not (shows it lower)" },
    "dietGoal": { "background": "#e9f4ec", "badge": "#e6f2ea", "usage": "Diet, goal" }
  },
  "screenTint": {
    "note": "Each kind of screen sits on its own tint, like a room. White cards float on it.",
    "welcome":    "#eaf3f8",
    "region":     "#eaf3f8",
    "store":      "#eaf3f8",
    "household":  "#ffffff",
    "goal":       "#f3f1fb",
    "why":        "#fdf6ea",
    "allergens":  "#fbf1ef",
    "severity":   "#fbf1ef",
    "medical":    "#fbf1ef",
    "strict":     "#fbf1ef",
    "diet":       "#eef8f1",
    "religion":   "#eef8f1",
    "avoid":      "#fdf6ea",
    "numbers":    "#f3f1fb",
    "summary":    "#eef8f1",
    "chat":       "#eef8f1",
    "scan":       "#000000",
    "product":    "#fdf6ea",
    "compareWith":"#f3f1fb",
    "compare":    "#f3f1fb",
    "family":     "#fdf6ea",
    "avatarTints": ["#ffe3b3", "#d8ecdf", "#e6e0fb", "#fbdcd6"]
  },
  "radius": { "card": 26, "tile": 22, "optionCard": 26, "leafTile": 22, "field": 12, "searchField": 22, "chip": 999, "button": 999, "checkbox": 9, "letterTile": "28% of size", "productThumb": 12, "phoneSheet": 28 },
  "shadow": {
    "card":     { "css": "0 1px 2px rgba(29,43,34,0.04), 0 10px 26px rgba(29,43,34,0.05)", "swiftUI": ".shadow(color: ink.opacity(0.04), radius: 1, y: 1).shadow(color: ink.opacity(0.05), radius: 13, y: 10)" },
    "primary":  { "css": "0 6px 18px rgba(235,157,21,0.3)" },
    "selected": { "css": "0 0 0 2px #1d2b22", "note": "Selected option card: a 2 pt ink outline instead of the shadow" }
  },
  "spacing": { "xxs": 4, "xs": 6, "s": 8, "m": 12, "l": 16, "xl": 20, "xxl": 24, "section": 28, "screenGutter": 20, "cardPaddingV": 14, "cardPaddingH": 18 },
  "size": {
    "minTap": 44,
    "optionCardMinHeight": 80,
    "tileMinHeight": 158,
    "leafTileMinHeight": 64,
    "primaryButtonHeight": 66,
    "checkbox": 30,
    "leafCheckbox": 26,
    "switch": [51, 31],
    "iconInCard": 48,
    "iconInTile": 64,
    "iconInChip": 22,
    "mascotOnboarding": 74,
    "mascotChatDock": 64,
    "mascotSectionHeading": 30,
    "verdictSignal": 60
  },
  "motion": {
    "easeOut": "cubic-bezier(0.23, 1, 0.32, 1)",
    "easeInOut": "cubic-bezier(0.77, 0, 0.175, 1)",
    "press": "100 to 160 ms",
    "sheet": "native sheet detents",
    "reasonSwap": "When the on-device summary replaces the deterministic reason: opacity crossfade 200 ms, no skeleton, no shimmer",
    "reduceMotion": "Mascot holds its pose; transitions become fades"
  },
  "materials": {
    "glass": "Liquid Glass only on floating controls (back, favorite, composer, the bottom action bar). Content stays flat."
  }
}
